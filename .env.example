# Copy this file to `.env` and fill in your real API key.
# Every variable below except ANTHROPIC_API_KEY is optional — sensible
# defaults are defined in config.py.

# --- Required ---------------------------------------------------------
ANTHROPIC_API_KEY= your-api-key-here

# --- Model selection ----------------------------------------------------
# Default: claude-haiku-4-5 (same model the original code used)
SMARTINTAKE_MODEL=claude-haiku-4-5

# --- Defensive API-call tuning (llm_client.py) ---------------------------
SMARTINTAKE_MAX_RETRIES=3
SMARTINTAKE_RETRY_BASE_DELAY=1.5

# --- Conversation memory tuning (memory.py) -------------------------------
# Number of raw turns kept before switching from buffer -> summary mode.
SMARTINTAKE_MEMORY_THRESHOLD=10
# Number of most-recent turns always kept verbatim once in summary mode.
SMARTINTAKE_MEMORY_KEEP_RECENT=4

# --- Failed-attempt escalation (session.py) -------------------------------
# Consecutive validation failures before falling back to a static,
# non-LLM follow-up question.
SMARTINTAKE_MAX_FAILED_ATTEMPTS=2

# --- Storage locations ----------------------------------------------------
SMARTINTAKE_OUTPUT_DIR=output
SMARTINTAKE_DEBUG_LOG=debug.log
